# Salin file ini menjadi .streamlit/secrets.toml lalu isi nilainya.
# JANGAN commit secrets.toml ke Git (sudah masuk .gitignore).
#
# PENTING: st.secrets bersifat CASE-SENSITIVE. Kode (whatsapp_alert.py)
# membaca nama secret huruf KECIL. Kalau ditulis huruf BESAR, nilainya
# tidak terbaca dan aplikasi menganggap WhatsApp belum dikonfigurasi.
# (Environment variable tetap huruf besar: WHATSAPP_TOKEN, dst.)

whatsapp_token = "EAAG..."                 # Access token Meta WhatsApp Cloud API
whatsapp_phone_number_id = "1234567890"    # Phone Number ID (bukan nomor teleponnya)
whatsapp_recipient = "6289515780328"       # Nomor tujuan notifikasi, format internasional
